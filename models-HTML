    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#0f0f10;
    color:white;
}

/* NAVBAR */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    background:#1a1a1d;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 50px;
    z-index:1000;
}

.logo{
    font-size:30px;
    font-weight:bold;
}

.logo span{
    color:#d86c9a;
}

.nav-links{
    display:flex;
    list-style:none;
    gap:25px;
}

.nav-links a{
    color:white;
    text-decoration:none;
    transition:0.3s;
}

.nav-links a:hover{
    color:#d86c9a;
}

/* PAGE HEADER */

.title{
    text-align:center;
    padding-top:120px;
    padding-bottom:40px;
}

.title h1{
    font-size:50px;
    color:#d86c9a;
    margin-bottom:10px;
}

.title p{
    color:#ccc;
    font-size:18px;
}

/* MODEL GRID */

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:25px;
    padding:40px;
}

.card{
    background:#1a1a1d;
    border-radius:15px;
    overflow:hidden;
    text-decoration:none;
    color:white;
    transition:0.4s;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 25px rgba(216,108,154,0.4);
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-content{
    padding:20px;
}

.card h2{
    margin-bottom:10px;
    color:#d86c9a;
}

.card p{
    color:#ccc;
    line-height:1.5;
}

/* MOBILE */

@media(max-width:768px){

    nav{
        flex-direction:column;
        gap:15px;
    }

    .title h1{
        font-size:38px;
    }

    .grid{
        padding:20px;
    }
}

</style>
</head>

